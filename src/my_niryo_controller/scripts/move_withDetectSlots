from pyniryo import *
import time
import cv2

# -----------------------------------------------------------------------------
# 颜色阈值
# -----------------------------------------------------------------------------
COLOR_THRESHOLDS_PIECE = {
    "RED": ([0, 80, 150], [15, 255, 255]),
    "ORANGE": ([16, 50, 150], [28, 200, 255]),
    "YELLOW": ([25, 40, 180], [45, 150, 255]),
    "GREEN": ([45, 50, 150], [75, 255, 255]),
    "BLUE": ([90, 150, 150], [120, 255, 255])
}

COLOR_THRESHOLDS_SLOT = {
    "RED": ([0, 100, 160], [7, 160, 210]),
    "ORANGE": ([9, 110, 160], [18, 160, 210]),
    "YELLOW": ([38, 70, 180], [45, 120, 230]),
    "GREEN": ([72, 90, 140], [80, 160, 190]),
    "BLUE": ([104, 200, 170], [112, 255, 220])
}

# ---------------------------
# 获取workspace图像
# ---------------------------
def get_workspace_image(workspace_name):
    mtx, dist = robot.get_camera_intrinsics()
    img_compressed = robot.get_img_compressed()
    img_raw = uncompress_image(img_compressed)
    img_undistort = undistort_image(img_raw, mtx, dist)

    show_img("camera_raw", img_undistort, wait_ms=1)

    img_workspace = vision.extract_img_workspace(
        img_undistort,
        1.0
    )

    if img_workspace is None:
        print("Workspace markers not detected:", workspace_name)
        return None

    # show_img("workspace_" + workspace_name, img_workspace, wait_ms=1)

    return img_workspace


# ---------------------------
# 识别拼图块
# ---------------------------
def detect_piece():

    robot.move(pickup_observation_pose)

    img = get_workspace_image(workspace_pieces)

    if img is None:
        return None, None

    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

    for color, (lower, upper) in COLOR_THRESHOLDS_PIECE.items():

        print("Trying color:", color)

        mask = cv2.inRange(hsv, tuple(lower), tuple(upper))

        mask = vision.morphological_transformations(
            mask,
            morpho_type=vision.MorphoType.ERODE,
            kernel_shape=(5,5),
            kernel_type=vision.KernelType.ELLIPSE
        )

        # show_img(color + "_mask", mask, wait_ms=30)

        contour = vision.biggest_contour_finder(mask)

        if contour is None:
            continue

        if len(contour) == 0:
            continue

        try:
            cx, cy = vision.get_contour_barycenter(contour)
        except:
            continue

        angle = vision.get_contour_angle(contour)

        # 三角形角度修正
        if color == "YELLOW":
            angle = 0  # 先试 +90°

        x_rel, y_rel = vision.relative_pos_from_pixels(img, cx, cy)

        print("Detected", color, "at", x_rel, y_rel)

        pose = robot.get_target_pose_from_rel(
            workspace_pieces,
            height_offset=0.01,
            x_rel=x_rel,
            y_rel=y_rel,
            yaw_rel=angle
        )

        return color, pose

    print("No piece detected in any color")

    return None, None


# ---------------------------
# 识别凹槽
# ---------------------------
def detect_slot(target_color):

    img = get_workspace_image(workspace_slots)

    if img is None:
        return None

    hsv = cv2.cvtColor(img, cv2.COLOR_BGR2HSV)

    lower, upper = COLOR_THRESHOLDS_SLOT[target_color]

    mask = cv2.inRange(hsv, tuple(lower), tuple(upper))

    mask = vision.morphological_transformations(
        mask,
        morpho_type=vision.MorphoType.OPEN,
        kernel_shape=(5,5),
        kernel_type=vision.KernelType.ELLIPSE
    )

    contour = vision.biggest_contour_finder(mask)

    if contour is None:
        return None

    if len(contour) == 0:
        return None

    try:
        cx, cy = vision.get_contour_barycenter(contour)
    except:
        return None

    x_rel, y_rel = vision.relative_pos_from_pixels(img, cx, cy)
    angle2 = vision.get_contour_angle(contour)

    # 三角形角度修正
    if target_color == "YELLOW":
        angle2 = 0  # 先试 +90°
        #print(angle2)

    pose = robot.get_target_pose_from_rel(
        workspace_slots,
        height_offset=0.03,
        x_rel=x_rel,
        y_rel=y_rel,
        yaw_rel=angle2
    )

    print(x_rel)
    print(y_rel)

    return pose


# ---------------------------
# 主程序
# ---------------------------
if __name__ == "__main__":

    pickup_observation_pose = PoseObject(0.2, 0.0, 0.25, 0.0, 1.80, 0.0)
    board_observation_pose = PoseObject(0.0, 0.2, 0.25, 0.0, 1.80, 1.57)

    robot_ip_address = '10.10.10.10'
    workspace_pieces = "Workspace_pieces"
    workspace_slots = "Workspace_slots"
    robot = NiryoRobot(robot_ip_address)

    if robot.collision_detected:
        robot.clear_collision_detected()

    robot.calibrate_auto()
    robot.update_tool()
    robot.open_gripper()

    while True:

        color, obj_pose = detect_piece()

        if obj_pose is None:
            print("No piece detected")
            continue

        print("Piece detected:", color)

        robot.pick(obj_pose)

        robot.move(board_observation_pose)
        time.sleep(0.3)

        slot_pose = detect_slot(color)

        if slot_pose is None:
            print("Slot not found, returning piece to original pickup position")
            
            # 回到抓取位置
            robot.move(obj_pose)
            time.sleep(0.2)
            robot.release_with_tool()
            
            continue

        print("Placing piece:", color)

        robot.place(slot_pose)

        key = cv2.waitKey(1)
        if key in [27, ord("q")]:
            break

    robot.close_connection()